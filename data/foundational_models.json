  "instantiations": [
    {
      "name": "String or finite word",
      "concepts": [
        "Sequence"
      ],
      "parameters": "Element carrier is an explicitly chosen alphabet; encoding and normalization are separate."
    },
    {
      "name": "Byte or octet",
      "concepts": [
        "FixedWidthUnsignedInteger"
      ],
      "parameters": "Width 8; choose arithmetic overflow behavior."
    },
    {
      "name": "Result or either",
      "concepts": [
        "SumType"
      ],
      "parameters": "Success and error carriers with distinct constructor tags."
    },
    {
      "name": "Record or named tuple",
      "concepts": [
        "RelationalSchema"
      ],
      "parameters": "Tuple carrier with finite named typed fields."
    },
    {
      "name": "Fixed-length vector",
      "concepts": [
        "Array"
      ],
      "parameters": "A and fixed natural length n; vector-space semantics requires additional scalar structure."
    },
    {
      "name": "Sparse matrix",
      "concepts": [
        "SparseVector"
      ],
      "parameters": "Index carrier I\u00d7J and field F; specify compatible dimensions and multiplication separately."
    },
    {
      "name": "Forest",
      "concepts": [
        "Sequence",
        "RoseTree"
      ],
      "parameters": "Ordered finite sequence of nonempty rose trees; empty forest permitted."
    },
    {
      "name": "Key/value store snapshot",
      "concepts": [
        "Map"
      ],
      "parameters": "Finite key/value bindings; persistence and transactional behavior are additional."
    },
    {
      "name": "Hierarchical data",
      "concepts": [
        "RoseTree",
        "DocumentValue"
      ],
      "parameters": "Choose ordered node labels or the explicit JSON profile."
    },
    {
      "name": "Network database view",
      "concepts": [
        "EntityRelationshipModel"
      ],
      "parameters": "Binary typed roles; historical navigational access paths require further refinement."
    }
  ]
}
