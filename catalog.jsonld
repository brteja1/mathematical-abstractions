    {
      "id": "urn:csabs:concept/ArbitraryPrecisionInteger",
      "type": "Concept",
      "shortForm": "ArbitraryPrecisionInteger",
      "fullName": "Arbitrary Precision Integer",
      "category": [
        "urn:csabs:category/numeric-computation"
      ],
      "kind": "urn:csabs:kind/data-type",
      "definition": "An integer value with no fixed mathematical width; implementations may exhaust resources even though the value semantics is unbounded.",
      "notation": "value ∈ ℤ; arithmetic exact when it returns normally",
      "hasOperation": [
        "urn:csabs:operation/ArbitraryPrecisionInteger-add",
        "urn:csabs:operation/ArbitraryPrecisionInteger-basis-subtract",
        "urn:csabs:operation/ArbitraryPrecisionInteger-basis-multiply"
      ],
      "hasAxiom": [
        "urn:csabs:axiom/ArbitraryPrecisionInteger-value-semantics"
      ],
      "hasLaw": [
        "urn:csabs:law/ArbitraryPrecisionInteger-core"
      ],
      "hasTheorem": [
        "urn:csabs:theorem/ArbitraryPrecisionInteger-normal-return-cancellation"
      ],
      "requiresConcept": [
        "urn:csabs:concept/MathematicalInteger"
      ],
      "coverageStatus": "basis-reviewed",
      "verificationObligation": [
        "Instantiate carrier, equality, and stated semantic conventions before using this entry.",
        "Use the stated carriers, equality, domain restrictions and semantic conventions; alternative conventions require an explicit variant."
      ],
      "axiomBasis": "Selected presentation: An integer value with no fixed mathematical width; implementations may exhaust resources even though the value semantics is unbounded. Governing rules: The abstract value carrier is unbounded integers, independently of resource limits.",
      "basisKind": "defined-structure",
      "basisScope": "Defining interface and selected derived results for the operations listed in this entry. Not an enumeration of all consequences or all alternative foundations.",
      "reviewStatus": "editorial basis review; no machine-checked mathematical proof",
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:concept/Array",
      "type": "Concept",
      "shortForm": "Array",
      "fullName": "Fixed-length array",
      "category": [
        "urn:csabs:category/data-structures"
      ],
      "kind": "urn:csabs:kind/abstract-data-type",
      "definition": "A finite indexed collection with one value per valid index; mutable variants are modeled by state-changing update operations.",
      "notation": "A : Index(n) → V; store(A,i,v)[j] = if i=j then v else A[j].",
      "source": [
        "urn:csabs:source/wikipedia-data-structures"
      ],
      "hasOperation": [
        "urn:csabs:operation/array-select",
        "urn:csabs:operation/array-store"
      ],
      "hasAxiom": [
        "urn:csabs:axiom/array-valid-index",
        "urn:csabs:axiom/Array-carrier",
        "urn:csabs:axiom/Array-extensionality",
        "urn:csabs:axiom/Array-store-definition"
      ],
      "hasLaw": [
        "urn:csabs:law/array-read-after-write-same",
        "urn:csabs:law/array-read-after-write-other"
      ],
      "hasTheorem": [
        "urn:csabs:theorem/Array-update-overwrite"
      ],
      "relatedConcept": [
        "urn:csabs:concept/Sequence"
      ],
      "coverageStatus": "basis-reviewed",
      "requiresConcept": [],
      "verificationObligation": [
        "Use the stated carriers, equality, domain restrictions and semantic conventions; alternative conventions require an explicit variant."
      ],
      "axiomBasis": "Selected presentation: A finite indexed collection with one value per valid index; mutable variants are modeled by state-changing update operations. Governing rules: Lookup and update are specified only for valid indices unless the ADT contract defines another behavior. An array of a fixed length is exactly a total map on that length's indices. Arrays of the same length and value carrier are equal when all indexed values agree. Store changes exactly one valid position and preserves the length.",
      "basisKind": "defined-structure",
      "basisScope": "Defining interface and selected derived results for the operations listed in this entry. Not an enumeration of all consequences or all alternative foundations.",
      "reviewStatus": "editorial basis review; no machine-checked mathematical proof"
    },
    {
      "id": "urn:csabs:concept/BagRelation",
      "type": "Concept",
      "shortForm": "BagRelation",
      "fullName": "Finite database relation under bag semantics",
      "category": [
        "urn:csabs:category/data-modelling"
      ],
      "kind": "urn:csabs:kind/abstract-data-type",
      "definition": "A finite multiset of well-typed named tuples over a fixed relational schema.",
      "notation": "BagRel(S)=Multiset(Tuple(S))",
      "requiresConcept": [
        "urn:csabs:concept/RelationalSchema",
        "urn:csabs:concept/Multiset",
        "urn:csabs:concept/DatabaseRelation"
      ],
      "relatedConcept": [],
      "hasOperation": [
        "urn:csabs:operation/BagRelation-multiplicity",
        "urn:csabs:operation/BagRelation-union-all",
        "urn:csabs:operation/BagRelation-project",
        "urn:csabs:operation/BagRelation-select"
      ],
      "hasAxiom": [
        "urn:csabs:axiom/Multiset-finite-support",
        "urn:csabs:axiom/Multiset-count-extensionality",
        "urn:csabs:axiom/Multiset-operations",
        "urn:csabs:axiom/BagRelation-project-count",
        "urn:csabs:axiom/BagRelation-selection-count"
      ],
      "hasLaw": [
        "urn:csabs:law/BagRelation-union-commutative"
      ],
      "hasTheorem": [
        "urn:csabs:theorem/BagRelation-projection-cardinality"
      ],
      "axiomBasis": "count(R,t) has finite support in t; R=T iff ∀t,count(R,t)=count(T,t); count(unionAll(R,T),t)=count(R,t)+count(T,t); count(project_X(R),u)=Σ{t∈supp(R) | t|X=u}count(R,t); count(select_P(R),t)=count(R,t) if P(t), else 0",
      "basisKind": "extensional-structural-definition",
      "basisScope": "No tuple ordering; equal rows retain natural-number multiplicity. No SQL NULL, three-valued predicates, ordering or aggregation overflow. Schema fixed; projection adds multiplicities when distinct rows collapse.",
      "coverageStatus": "basis-reviewed",
      "verificationObligation": [
        "Map carrier, equality, operation definedness and stated profile to the target API or proof context.",
        "Prerequisites and hierarchy links do not transfer axioms; retrieve explicit premises.",
        "Model coverage does not establish every recorded claim or an implementation refinement."
      ],
      "reviewStatus": "Editorial source/interface review with a Lean carrier binding; individual witnesses recorded separately.",
      "source": [
        "urn:csabs:source/mathlib-bag-core"
      ],
      "sourceLocator": "Multiset as lists modulo permutation; count, addition, cardinality",
      "sourceNote": "Adapted to the explicitly stated finite, typed and equality conventions of this entry. Additional profile restrictions and operation specifications are catalog choices, not claims about every implementation.",
      "provenanceKind": "adapted",
      "specializationOf": [
        "urn:csabs:concept/Multiset"
      ],
      "specializationNote": "Instantiate Multiset at the dependent named-tuple carrier of S. unionAll is multiset additive union ⊎; count, empty, insert and remove keep their occurrence-count meanings. Projection and selection are additional typed operations. All reused axioms have explicit applicability; the hierarchy alone transfers no rule."
    },
    {
      "id": "urn:csabs:concept/BayesianNetwork",
      "type": "Concept",
      "shortForm": "BayesianNetwork",
      "fullName": "Bayesian network (finite discrete variables)",
      "category": [
        "urn:csabs:category/probability",
        "urn:csabs:category/graphs"
      ],
      "kind": "urn:csabs:kind/semantic-model",
      "definition": "A finite directed acyclic graph equipped with a nonempty finite value set per node and a normalized conditional probability table for every parent assignment, defining a joint law by their product.",
      "notation": "G=(V,E) a finite DAG; p(x_V)=∏_{v∈V}q_v(x_v∣x_pa(v))",
      "hasOperation": [
        "urn:csabs:operation/BayesianNetwork-joint",
        "urn:csabs:operation/BayesianNetwork-marginal",
        "urn:csabs:operation/BayesianNetwork-posterior"
      ],
      "hasAxiom": [
        "urn:csabs:axiom/BayesianNetwork-local-tables",
        "urn:csabs:axiom/BayesianNetwork-factorization"
      ],
      "hasLaw": [],
      "hasTheorem": [
        "urn:csabs:theorem/BayesianNetwork-joint-normalization"
      ],
      "axiomBasis": "Finite DAG, nonempty finite variable carriers, and nonnegative normalized local tables; joint factorization is a definition.",
      "basisKind": "defined-structure",
      "basisScope": "Exact finite joint evaluation, marginalization and positive-evidence conditioning. No causal or faithfulness assumption is imposed.",
      "coverageStatus": "basis-reviewed",
