    {
      "id": "urn:csabs:axiom/ArbitraryPrecisionInteger-value-semantics",
      "type": "Axiom",
      "name": "value-semantics",
      "statement": "The abstract value carrier is unbounded integers, independently of resource limits.",
      "formalStatement": "Values=ℤ; normalReturn(op(x,y)) ⇒ value(result)=op_ℤ(value(x),value(y)), op∈{+,−,×}",
      "appliesTo": [
        "urn:csabs:concept/ArbitraryPrecisionInteger"
      ],
      "assumptions": [
        "All variables range over the carriers and semantic conventions specified in this concept."
      ],
      "ruleRole": "defining-rule",
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:axiom/Array-carrier",
      "type": "Axiom",
      "name": "carrier",
      "statement": "An array of a fixed length is exactly a total map on that length's indices.",
      "formalStatement": "Array(n,V)=V^Index(n); Index(n)={i∈ℕ:i<n}",
      "appliesTo": [
        "urn:csabs:concept/Array"
      ],
      "assumptions": [
        "All variables range over the carriers and semantic conventions specified in this concept."
      ],
      "ruleRole": "defining-rule",
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:axiom/Array-extensionality",
      "type": "Axiom",
      "name": "extensionality",
      "statement": "Arrays of the same length and value carrier are equal when all indexed values agree.",
      "formalStatement": "A=B iff ∀i∈Index(n):select(A,i)=select(B,i)",
      "appliesTo": [
        "urn:csabs:concept/Array"
      ],
      "assumptions": [
        "All variables range over the carriers and semantic conventions specified in this concept."
      ],
      "ruleRole": "defining-rule",
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:axiom/Array-store-definition",
      "type": "Axiom",
      "name": "store-definition",
      "statement": "Store changes exactly one valid position and preserves the length.",
      "formalStatement": "select(store(A,i,v),j)=if j=i then v else select(A,j); i,j∈Index(n)",
      "appliesTo": [
        "urn:csabs:concept/Array"
      ],
      "assumptions": [
        "All variables range over the carriers and semantic conventions specified in this concept."
      ],
      "ruleRole": "defining-rule",
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:axiom/BagRelation-project-count",
      "type": "Axiom",
      "name": "project-count",
      "statement": "Defining requirement: count(project_X(R),u)=Σ{t∈supp(R) | t|X=u}count(R,t)",
      "formalStatement": "count(project_X(R),u)=Σ{t∈supp(R) | t|X=u}count(R,t)",
      "assumptions": [
        "No tuple ordering; equal rows retain natural-number multiplicity. No SQL NULL, three-valued predicates, ordering or aggregation overflow. Schema fixed; projection adds multiplicities when distinct rows collapse.",
        "All variables range over the typed carriers in the notation and signatures."
      ],
      "appliesTo": [
        "urn:csabs:concept/BagRelation"
      ],
      "ruleRole": "defining-rule",
      "reviewStatus": "Editorial source/interface review; Lean model and individual proof evidence are separate.",
      "source": [
        "urn:csabs:source/mathlib-bag-core"
      ],
      "sourceLocator": "Multiset as lists modulo permutation; count, addition, cardinality",
      "sourceNote": "Adapted to the explicitly stated finite, typed and equality conventions of this entry. Additional profile restrictions and operation specifications are catalog choices, not claims about every implementation.",
      "provenanceKind": "adapted"
    },
    {
      "id": "urn:csabs:axiom/BagRelation-selection-count",
      "type": "Axiom",
      "name": "selection-count",
      "statement": "Defining requirement: count(select_P(R),t)=count(R,t) if P(t), else 0",
      "formalStatement": "count(select_P(R),t)=count(R,t) if P(t), else 0",
      "assumptions": [
        "No tuple ordering; equal rows retain natural-number multiplicity. No SQL NULL, three-valued predicates, ordering or aggregation overflow. Schema fixed; projection adds multiplicities when distinct rows collapse.",
        "All variables range over the typed carriers in the notation and signatures."
