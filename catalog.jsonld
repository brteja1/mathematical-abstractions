    },
    {
      "id": "urn:csabs:theorem/coproduct-universal",
      "type": "Theorem",
      "name": "coproduct-universal",
      "statement": "For any two branch functions, there exists exactly one function out of the sum with those branches.",
      "formalStatement": "∀f:A→C,g:B→C ∃!h:A+B→C: h∘inl=f ∧ h∘inr=g",
      "assumptions": [
        "Extensional total set-like types; all displayed functions total and correctly typed."
      ],
      "appliesTo": [
        "urn:csabs:concept/SumType"
      ],
      "dependsOn": [
        "urn:csabs:axiom/case-inl",
        "urn:csabs:axiom/case-inr",
        "urn:csabs:axiom/sum-eta",
        "urn:csabs:axiom/map-sum-definition",
        "urn:csabs:axiom/sum-swap-definition",
        "urn:csabs:axiom/sum-associate-definition"
      ],
      "source": [
        "urn:csabs:source/awodey-types"
      ],
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "proofSketch": "Existence: h=case(f,g), using the two computation equations. Uniqueness: eta rewrites any candidate h as case(h∘inl,h∘inr)=case(f,g)."
    },
    {
      "id": "urn:csabs:theorem/empty-initial",
      "type": "Theorem",
      "name": "empty-initial",
      "statement": "The empty type is initial in the category of set-like types and total functions.",
      "formalStatement": "∀C ∃!f:0→C",
      "assumptions": [
        "Extensional total set-like types; all displayed functions total and correctly typed."
      ],
      "appliesTo": [
        "urn:csabs:concept/EmptyType"
      ],
      "dependsOn": [
        "urn:csabs:axiom/absurd-unique"
      ],
      "source": [
        "urn:csabs:source/awodey-types"
      ],
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "proofSketch": "Existence is the eliminator; uniqueness is absurd-unique."
    },
    {
      "id": "urn:csabs:theorem/equivalence-partition-correspondence",
      "type": "Theorem",
      "statement": "Equivalence relations on A correspond bijectively to partitions of A by their equivalence classes.",
      "assumptions": [
        "underlying carrier A fixed"
      ],
      "appliesTo": [
        "urn:csabs:concept/EquivalenceRelation",
        "urn:csabs:concept/Partition"
      ],
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "dependsOn": [
        "urn:csabs:axiom/equivalence-reflexive",
        "urn:csabs:axiom/equivalence-symmetric",
        "urn:csabs:axiom/equivalence-transitive",
        "urn:csabs:axiom/EquivalenceRelation-class-definition",
        "urn:csabs:axiom/partition-cover",
        "urn:csabs:axiom/partition-disjoint",
        "urn:csabs:axiom/Partition-blocks"
      ],
      "formalStatement": "Equiv(A) ≅ Partitions(A); R↦{[a]_R:a∈A}; Π↦{(a,b):∃B∈Π:a∈B∧b∈B}",
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:theorem/finite-product-cardinality",
      "type": "Theorem",
      "statement": "The cardinality of the product of finite sets is the product of their cardinalities.",
      "formalStatement": "|A×B|=|A|·|B|",
      "assumptions": [
        "A and B finite"
      ],
      "appliesTo": [
        "urn:csabs:concept/CartesianProduct"
      ],
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "dependsOn": [
        "urn:csabs:axiom/CartesianProduct-pair-equality",
        "urn:csabs:axiom/CartesianProduct-membership",
        "urn:csabs:axiom/CartesianProduct-projection"
      ],
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:theorem/injections-disjoint",
      "type": "Theorem",
      "name": "injections-disjoint",
      "statement": "The left and right injections have disjoint images.",
      "formalStatement": "∀a:A,b:B: inl(a)≠inr(b)",
      "assumptions": [
        "Extensional total set-like types; all displayed functions total and correctly typed.",
        "Boolean values false and true are distinct."
      ],
      "appliesTo": [
        "urn:csabs:concept/SumType"
      ],
      "dependsOn": [
        "urn:csabs:axiom/case-inl",
        "urn:csabs:axiom/case-inr",
        "urn:csabs:axiom/sum-eta",
        "urn:csabs:axiom/map-sum-definition",
        "urn:csabs:axiom/sum-swap-definition",
        "urn:csabs:axiom/sum-associate-definition"
      ],
      "source": [
        "urn:csabs:source/awodey-types"
      ],
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "proofSketch": "Case into Bool, returning false for the left branch and true for the right. Equality of the inputs would imply false=true."
    },
    {
      "id": "urn:csabs:theorem/injections-injective",
      "type": "Theorem",
      "name": "injections-injective",
      "statement": "Each injection preserves and reflects equality of its payloads.",
      "formalStatement": "inl(a)=inl(a′) iff a=a′; inr(b)=inr(b′) iff b=b′",
      "assumptions": [
        "Extensional total set-like types; all displayed functions total and correctly typed."
      ],
      "appliesTo": [
        "urn:csabs:concept/SumType"
      ],
      "dependsOn": [
        "urn:csabs:axiom/case-inl",
        "urn:csabs:axiom/case-inr",
        "urn:csabs:axiom/sum-eta",
        "urn:csabs:axiom/map-sum-definition",
        "urn:csabs:axiom/sum-swap-definition",
        "urn:csabs:axiom/sum-associate-definition"
      ],
      "source": [
        "urn:csabs:source/awodey-types"
      ],
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "proofSketch": "For a fixed left value a, case(id_A, λb.a) recovers each left payload; use it on the proposed equality. The right proof is symmetric. The reverse implications follow by congruence."
    },
    {
      "id": "urn:csabs:theorem/lagrange",
      "type": "Theorem",
      "statement": "The order of a subgroup divides the order of a finite group.",
      "formalStatement": "H≤G, |G|<∞ ⇒ |H| divides |G|",
      "assumptions": [
        "G finite group",
        "H subgroup"
      ],
      "appliesTo": [
