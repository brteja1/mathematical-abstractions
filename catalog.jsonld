      "type": "Axiom",
      "name": "induction",
      "statement": "Predicates holding for nil and preserved by cons hold for every finite sequence.",
      "formalStatement": "P(nil) ∧ (∀x,s:P(s)⇒P(cons(x,s))) ⇒ ∀s∈Seq(V):P(s)",
      "appliesTo": [
        "urn:csabs:concept/Sequence"
      ],
      "assumptions": [
