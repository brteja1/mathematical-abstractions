    {
      "id": "urn:csabs:theorem/ArbitraryPrecisionInteger-normal-return-cancellation",
      "type": "Theorem",
      "name": "normal-return-cancellation",
      "statement": "Successful addition by a fixed integer preserves injectivity of numeric values.",
      "formalStatement": "normal(add(a,b))=r ∧ normal(add(a,c))=s ∧ value(r)=value(s) ⇒ value(b)=value(c)",
      "proofSketch": "Exact normal-return semantics reduces the premise to integer addition cancellation.",
      "assumptions": [
        "The explicit basis, carriers, and side conditions stated for ArbitraryPrecisionInteger apply."
      ],
      "appliesTo": [
        "urn:csabs:concept/ArbitraryPrecisionInteger"
      ],
      "dependsOn": [
        "urn:csabs:axiom/ArbitraryPrecisionInteger-value-semantics"
      ],
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:theorem/Array-update-overwrite",
      "type": "Theorem",
      "name": "update-overwrite",
      "statement": "Two writes to the same valid index retain only the last value.",
      "formalStatement": "store(store(A,i,v),i,w)=store(A,i,w)",
      "proofSketch": "Read each valid index; the two store equations give identical values; apply array extensionality.",
      "assumptions": [
        "The explicit basis, carriers, and side conditions stated for Array apply."
      ],
      "appliesTo": [
        "urn:csabs:concept/Array"
      ],
      "dependsOn": [
        "urn:csabs:axiom/array-valid-index",
        "urn:csabs:axiom/Array-carrier",
        "urn:csabs:axiom/Array-extensionality",
        "urn:csabs:axiom/Array-store-definition"
      ],
      "reviewStatus": "editorial-summary; not machine-proved",
      "notationLanguage": "informal mathematical Unicode",
      "provenanceStatus": "legacy-source-missing"
    },
    {
      "id": "urn:csabs:theorem/BagRelation-projection-cardinality",
      "type": "Theorem",
      "name": "projection-cardinality",
      "statement": "|project_X(R)|=|R|, counting multiplicities",
      "formalStatement": "|project_X(R)|=|R|, counting multiplicities",
      "assumptions": [
        "No tuple ordering; equal rows retain natural-number multiplicity. No SQL NULL, three-valued predicates, ordering or aggregation overflow. Schema fixed; projection adds multiplicities when distinct rows collapse.",
        "Typed mathematical equality and the stated defining requirements."
      ],
      "appliesTo": [
        "urn:csabs:concept/BagRelation"
      ],
      "dependsOn": [
        "urn:csabs:axiom/Multiset-finite-support",
        "urn:csabs:axiom/Multiset-count-extensionality",
        "urn:csabs:axiom/BagRelation-project-count"
      ],
