    {
      "id": "urn:csabs:theorem/MeasureSpace-monotonicity",
      "type": "Theorem",
      "name": "monotonicity",
      "statement": "Measure is monotone on measurable sets.",
      "formalStatement": "A,B∈Σ and A⊆B ⇒ μ(A)≤μ(B)",
      "appliesTo": [
        "urn:csabs:concept/MeasureSpace"
      ],
      "assumptions": [
