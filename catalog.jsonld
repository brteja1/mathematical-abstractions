    {
      "id": "urn:csabs:concept/BinaryTree",
      "type": "Concept",
      "shortForm": "BinaryTree",
      "fullName": "Finite ordered binary tree with node labels",
      "definition": "A finite rooted binary tree whose actual nodes carry labels in A and have ordered left and right child positions, each possibly empty. Values are freely generated by an empty tree E and a node constructor N(a,l,r).",
      "notation": "BT(A)=μX.(1+A×X×X); t ::= E | N(a,t_left,t_right).",
      "category": [
        "urn:csabs:category/data-structures",
