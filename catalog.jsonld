      "type": "Law",
      "name": "sum-map-composition",
      "statement": "Sum mapping preserves composition of branch maps.",
      "formalStatement": "mapSum(f₂,g₂)∘mapSum(f₁,g₁)=mapSum(f₂∘f₁,g₂∘g₁)",
      "assumptions": [
