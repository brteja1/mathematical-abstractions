  "clauses": {
    "GAP": {
      "source": "ai/skills/mathematical-tests/references/catalog-use.md",
      "quote": "Keep the original task's dependent work stopped until a suitable catalog entry is retrieved, or the acquisition workflow's verification and explicit retention choice have completed."
    },
    "CONDITIONAL": {
      "source": "ai/skills/mathematical-tests/references/catalog-use.md",
      "quote": "Conditional continuation with unverified assumptions also requires an explicit user choice and conditional labeling."
    },
    "TOOLING": {
      "source": "ai/skills/mathematical-tests/references/catalog-use.md",
      "quote": "Otherwise resolve setup or report the blocker."
    },
    "RETENTION": {
      "source": "ai/skills/mathematical-tests/references/catalog-use.md",
      "quote": "Catalog promotion is the default recommendation; task-local retention requires the user's explicit choice and must stay visibly separate from catalog entries."
    },
    "SCOPE": {
      "source": "ai/skills/spec-driven-development/SKILL.md",
      "quote": "Implementation is authorized only within the user's requested scope and resolved contract."
    },
    "LEDGER": {
      "source": "ai/skills/requirements-formalization/SKILL.md",
      "quote": "For an authorized lifecycle task, record these in the shared obligation ledger; a standalone requirements task may retain them in its specification without creating a lifecycle ledger."
    },
    "PROOF": {
      "source": "ai/skills/implementation-refinement/SKILL.md",
      "quote": "mark it unsupported for automated proof admission."
    },
    "FRESH": {
      "source": "ai/skills/spec-driven-development/SKILL.md",
      "quote": "Admit only when every declared required check has fresh successful evidence, requirements have honest validation receipts and blocking decisions are resolved."
    },
    "H-requirements-formalization": {
      "source": "ai/skills/requirements-formalization/SKILL.md",
      "quote": "Use specification-consistency for joint satisfiability, input/output coverage and nonvacuity."
    },
    "H-spec-driven-development": {
      "source": "ai/skills/spec-driven-development/SKILL.md",
      "quote": "Route intent to requirements-formalization, conflicts to specification-consistency, representation/API decisions to implementation-mapping, and required mathematical gaps to abstraction-acquisition after reporting them."
    },
    "H-implementation-mapping": {
      "source": "ai/skills/implementation-mapping/SKILL.md",
      "quote": "Use [mathematical-tests](../mathematical-tests/SKILL.md) for derived tests and [implementation-conformance](../implementation-conformance/SKILL.md) for comparison against the mapping."
    },
    "H-implementation-conformance": {
      "source": "ai/skills/implementation-conformance/SKILL.md",
      "quote": "use the acquisition workflow for catalog edits and proof promotion when a required mathematical gap is found."
    },
    "H-abstraction-discovery": {
      "source": "ai/skills/abstraction-discovery/SKILL.md",
      "quote": "Use [implementation-mapping](../implementation-mapping/SKILL.md) to formalize the updated API contract."
    },
    "H-compositional-verification": {
      "source": "ai/skills/compositional-verification/SKILL.md",
      "quote": "Keep each as a separate obligation and use formal-model-checking where appropriate."
    },
    "H-implementation-refinement": {
      "source": "ai/skills/implementation-refinement/SKILL.md",
      "quote": "Use mathematical-tests for API tests and implementation-conformance to challenge the mapping;"
    },
    "H-formal-model-checking": {
      "source": "ai/skills/formal-model-checking/SKILL.md",
      "quote": "Use [implementation-mapping](../implementation-mapping/SKILL.md) to formalize the checked atomic actions into concrete code methods."
    },
    "H-abstraction-acquisition": {
      "source": "ai/skills/abstraction-acquisition/SKILL.md",
      "quote": "Resume the original skill and task using a versioned mapping from the acquired operations and proved propositions to its inputs, API or specification."
    },
    "H-verification-maintenance": {
      "source": "ai/skills/verification-maintenance/SKILL.md",
      "quote": "Rerun affected checks using the run command, then check admission."
    },
    "H-assurance-review": {
      "source": "ai/skills/assurance-review/SKILL.md",
      "quote": "Deliver findings with clause/obligation IDs, source locators, reproduction commands and consequence."
    },
    "LIFECYCLE": {
      "source": "ai/skills/spec-driven-development/SKILL.md",
      "quote": "Use compositional-verification for component connections, implementation-refinement for actual source correspondence, mathematical-tests for behavior tests and formal-model-checking for concurrent models."
    },
    "REVIEW": {
      "source": "ai/skills/spec-driven-development/SKILL.md",
      "quote": "Before delivery, use implementation-conformance and assurance-review to challenge the contract and result. Run verification-maintenance after each meaningful change."
    }
  },
