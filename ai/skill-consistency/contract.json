  "rules": [
    {
      "id": "P1",
      "clauses": [
        "GAP",
        "CONDITIONAL",
        "TOOLING"
      ],
      "formula": {
        "iff": [
          "continueDependent",
          {
            "and": [
              "retrievalReady",
              {
                "or": [
                  {
                    "not": "mathMissing"
                  },
                  {
                    "and": [
                      "acquisitionVerified",
                      "retentionChosen"
                    ]
                  },
                  "conditionalChosen"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "P2",
      "clauses": [
        "SCOPE"
      ],
      "formula": {
        "implies": [
          "writeImplementation",
          {
            "and": [
              "implementationAuthorized",
              "continueDependent"
            ]
          }
        ]
      }
    },
    {
      "id": "P3",
      "clauses": [
        "RETENTION",
        "GAP",
        "SCOPE"
      ],
      "formula": {
        "implies": [
          "promote",
          {
            "and": [
              "retrievalReady",
              "acquisitionVerified",
              "retentionChosen",
              "promotionAuthorized"
            ]
          }
        ]
      }
    },
    {
      "id": "P4",
      "clauses": [
        "PROOF",
        "FRESH",
        "CONDITIONAL"
      ],
      "formula": {
        "implies": [
          "admitSourceProof",
          {
            "and": [
              "supportedProof",
              "proofFresh",
              {
                "not": "conditionalChosen"
              },
              "continueDependent"
            ]
          }
        ]
      }
    },
    {
      "id": "P5",
      "clauses": [
        "LEDGER"
      ],
      "formula": {
        "iff": [
          "requireLedger",
          "lifecycleAuthorized"
        ]
      }
    }
  ],
